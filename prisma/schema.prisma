// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Tabla que sincroniza con Supabase Auth (auth.users).
/// El `id` NO se genera aquí: es el mismo UUID que Supabase asigna al
/// crear el usuario en Auth. Este modelo guarda datos de perfil/negocio
/// adicionales que Supabase Auth no maneja.
model Profile {
  id                   String    @id @db.Uuid
  fullName             String?   @map("full_name")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  gender               Gender?
  country              String?   @db.Char(2)
  phone                String?
  avatarUrl            String?   @map("avatar_url")
  deletedAt            DateTime? @map("deleted_at")
  lastSeenAt           DateTime? @map("last_seen_at")
  onboardingCompleted  Boolean   @default(false)
  notificationsEnabled Boolean   @default(true)

  @@map("profile")
}
