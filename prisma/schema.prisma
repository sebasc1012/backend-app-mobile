// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tabla que sincroniza con Supabase Auth (auth.users).
/// El `id` NO se genera aquí: es el mismo UUID que Supabase asigna al
/// crear el usuario en Auth. Este modelo guarda datos de perfil/negocio
/// adicionales que Supabase Auth no maneja.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}